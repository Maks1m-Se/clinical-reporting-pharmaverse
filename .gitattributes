# Line-ending normalisation for future commits. Existing committed files are
# deliberately NOT renormalised (no `git add --renormalize`), so every log and
# output already in history stays byte-identical to the run that produced it.
* text=auto
*.R   text eol=lf
*.py  text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.html linguist-generated=true

# sdtm_ct.csv was committed with CRLF before normalisation was introduced. It is
# kept byte-identical, so line-ending conversion is switched off for this file;
# without this, a fresh clone reports it as modified.
question_1_sdtm/sdtm_ct.csv -text
